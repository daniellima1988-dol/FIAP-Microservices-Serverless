{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "FeedbackReclamacao",
  "type": "object",
  "properties": {
    "id_cliente": { "type": "string", "minLength": 1 },
    "descricao":  { "type": "string", "minLength": 1 },
    "categoria":  { "type": "string", "enum": ["elogio", "reclamação", "sugestão"] },
    "data_hora":  { "type": "string", "minLength": 1 }
  },
  "required": ["id_cliente", "descricao", "categoria", "data_hora"],
  "additionalProperties": false
}
